{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskOrbit",
  "version": "0.1.5",
  "identifier": "ir.sepehra.taskorbit",
  "build": {
    "beforeDevCommand": "npx vite --host 127.0.0.1",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TaskOrbit",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A lighter orbit for team work",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5MjcyNzE1QzNBMDA4MUQKUldRZENLRERGU2NuU1cvWldheDVaRTBvVEVnalNKdEs0WTZ6RllPZnVXVklCTmQxcDB2Q0krQjIK",
      "endpoints": [
        "https://github.com/sajadjanat/taskorbit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
